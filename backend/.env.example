# Copy this file to .env for local development. Never commit the real .env.
# In production (Render), set these as dashboard environment variables instead.

# Postgres connection string, e.g. from Neon:
# postgres://user:password@host/dbname?sslmode=require
DATABASE_URL=postgres://postgres:postgres@localhost:5432/umn_map?sslmode=disable

# Port the HTTP server listens on. Render sets this automatically; only needed
# for local dev.
PORT=8080

# Origin allowed to call the API from a browser (your deployed frontend URL).
# Use http://localhost:5500 or similar while developing locally.
ALLOWED_ORIGIN=http://localhost:5500

# Firebase project ID (from the Firebase console, Project Settings).
FIREBASE_PROJECT_ID=your-firebase-project-id

# Contents of a Firebase service account JSON key, as a single-line string.
# Generate via Firebase console -> Project Settings -> Service Accounts ->
# Generate new private key. Paste the full JSON here (keep it on one line).
# Alternatively, leave this unset and set GOOGLE_APPLICATION_CREDENTIALS to a
# file path instead.
FIREBASE_SERVICE_ACCOUNT_JSON=
